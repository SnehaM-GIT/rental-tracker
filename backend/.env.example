PORT=5000

# Email Notification Configuration (via Gmail SMTP)
# 1. Use your Gmail address as SMTP_USER
# 2. For SMTP_PASS: Go to Google Account → Security → 2-Step Verification → App Passwords
#    Generate a 16-character app password and paste it here (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
